# ============================================================
# HireTrack API — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=hiretrackdb
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/hiretrackdb
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-strong-password

# ── JWT ───────────────────────────────────────────────────
# Must be at least 32 characters for HMAC-SHA256.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-secure-random-key-at-least-32-chars
JWT_EXPIRATION=86400000

# ── Application ──────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
FILE_UPLOAD_DIR=uploads

# ── Connection Pool ──────────────────────────────────────
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5
